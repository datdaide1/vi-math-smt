 "rules": [
  {"id": "CR-1", "en": "\\b(\\d+(?:\\.\\d+)?|one|two|three|four|five|six|seven|eight|nine|ten|twelve|twenty) (more|fewer|less) (?:[\\w$-]+ ){1,3}than\\b", "vi_forbid": "(nhiều|ít) hơn \\$?\\d[\\d.,]*(?![^.,;:?]{0,40}so với)", "line": "'A có N X nhiều hơn B' → 'A có nhiều hơn B N X' (hoặc '... nhiều hơn số X của B là N'). KHÔNG viết 'A có nhiều hơn N X' mà thiếu đối tượng so sánh (sẽ thành 'hơn N')."},
  {"id": "CR-2", "en": "(?<![/\\d])\\b(\\d+|one|two|three|four|five|six|seven|eight|nine|ten) of the remaining\\b", "vi_require": "trong số", "line": "'N of the remaining X' → 'N trong số X còn lại'. KHÔNG viết 'N X còn lại' (= 'N X cuối cùng')."},
  {"id": "CR-3", "en": "\\b(\\d+|\\w+) (more|less|fewer) than (twice|double|triple|half|\\w+ times|\\d+ times)\\b", "vi_forbid": "(nhiều|ít) hơn \\d+ lần", "line": "'N more than twice/k times Y' → 'nhiều hơn k lần Y là N' (= kY + N). KHÔNG viết 'nhiều hơn N lần'."},
  {"id": "CR-4", "en": "subtracted from|\\bdivides\\b|\\blighter\\b|\\bheavier\\b|\\b\\w+ less than\\b", "line": "Giữ đúng chiều: 'b subtracted from a' → 'lấy a trừ đi b'; 'a divides b' → 'a là ước của b' / 'b chia hết cho a'; 'nhẹ hơn' ≠ 'nặng hơn'."},
  {"id": "CR-5", "en": "\\bstrictly\\b|\\bat least\\b|\\bat most\\b|\\bno more than\\b", "vi_forbid": "đáng kể", "line": "'strictly less/cheaper' → '(thực sự) nhỏ hơn / rẻ hơn'; 'at least' → 'ít nhất'; 'at most / no more than' → 'nhiều nhất / không vượt quá'. KHÔNG dùng 'đáng kể'."},
  {"id": "CR-6", "en": "\\b\\d+/\\d+ times (more|as|less)\\b", "line": "'k/m times as many' → 'bằng k/m lần'. Giữ nguyên phép nhân."}
 ]
