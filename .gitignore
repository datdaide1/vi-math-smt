# Data — datasets, generated outputs, model predictions (large, regenerable
# from the pipeline). See README.md for how to populate this locally.
data/

# Results — run artifacts, predictions, plots (regenerable). Tracked prose
# deliverables live under docs/ and results/*.md instead.
results/**
!results/**/
!results/**/*.md

# Secrets
.env
.env.*
!.env.example

# Claude Code local settings (machine-specific, not project config)
.claude/settings.local.json
.claude

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
*.egg-info/
.pytest_cache/
.coverage

# OS
.DS_Store
Thumbs.db

# scratch
_scratch/
