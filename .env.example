# Copy this file to .env (or export these as real environment variables) and
# fill in your own keys. Never commit the real .env file.

# ---------------------------------------------------------------------------
# ACTIVE — the new research pipeline (see RESEARCH_PLAN.md / EXECUTION.md)
# ---------------------------------------------------------------------------

# DeepSeek V4 — the SINGLE generative model for the augmentation arms:
#   * S1 informalization  * S2/S3 problem+solution generation
# One fixed model so each arm is a well-defined condition. For rate limits,
# add MORE DeepSeek keys here (comma-separated) — never mix in other providers
# for a generative task. A few $ of DeepSeek's paid tier is the fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=

# Google Gemini 2.5 Flash — used for: original translation (already done) and
# as ONE of the independent solvers in the round-trip / self-consistency check
# (multiple independent solvers there is intentional). Not used for generation.
GEMINI_API_KEY=

# GLM / Zhipu (optional) — a second independent solver for the round-trip
# check only. Not used for generation.
GLM_API_KEY=

# HuggingFace — model/dataset upload & download on Kaggle / Modal.
HF_TOKEN=

# ---------------------------------------------------------------------------
# LEGACY — used only by the old pipeline in src/; not part of the new plan
# ---------------------------------------------------------------------------
NVIDIA_API_KEYS=
NVIDIA_API_KEY=
BEEKNOEE_API_KEY=
