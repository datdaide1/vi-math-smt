# Copy this file to .env (or export these as real environment variables) and
# fill in your own keys. Never commit the real .env file.

# HuggingFace — used by notebooks/ (model/dataset upload & download)
HF_TOKEN=

# Google Gemini — used by data_translation/ (translation to Vietnamese)
GEMINI_API_KEY=

# NVIDIA NIM (integrate.api.nvidia.com) — used by src/mutation-informalize/
# and src/formailize/ (openai/gpt-oss-120b formalization calls).
# config.py accepts a comma-separated list for key rotation across workers;
# the standalone notebooks only need a single key.
NVIDIA_API_KEYS=
NVIDIA_API_KEY=

# Beeknoee (LLM proxy/router) — used by a few data_translation/ and
# src/formailize/ scripts. If you don't use this proxy, point BASE_URL in
# those scripts at your own provider instead.
BEEKNOEE_API_KEY=
