# Copy this file to .env (or export these as real environment variables) and
# fill in your own keys. Never commit the real .env file.

# ---------------------------------------------------------------------------
# ACTIVE — the new research pipeline (see RESEARCH_PLAN.md / EXECUTION.md)
# NO PAID SERVICES. All keys below are free tiers.
# ---------------------------------------------------------------------------

# GENERATION model (S1 informalization + S2/S3) = deepseek-ai/deepseek-v4-pro-0813
# via NVIDIA NIM (https://integrate.api.nvidia.com/v1). seed=42 supported.
# The @hus.edu.vn account is rate-limit-only: 40 RPM, NO credit cap.
# One fixed model = each arm is a well-defined condition.
NVIDIA_API_KEY=

# DeepSeek direct API (api.deepseek.com, 5M-token signup grant) -- fallback
# generator + one of the independent round-trip solvers.
DEEPSEEK_API_KEY=

# Google Gemini 3.1 Flash Lite (FREE, several keys) -- fallback generator if the
# DeepSeek budget runs out, AND one of the independent round-trip solvers.
GEMINI_API_KEYS=
GEMINI_API_KEY=

# HuggingFace — model/dataset upload & download on Kaggle / Modal.
HF_TOKEN=

# ---------------------------------------------------------------------------
# LEGACY — old src/ pipeline only (translation proxy); not used by the new plan
# ---------------------------------------------------------------------------
BEEKNOEE_API_KEY=
BEEKNOEE_API_KEY=
