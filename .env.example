# Copy this file to .env (or export these as real environment variables) and
# fill in your own keys. Never commit the real .env file.

# ---------------------------------------------------------------------------
# ACTIVE — the new research pipeline (see RESEARCH_PLAN.md / EXECUTION.md)
# NO PAID SERVICES. All keys below are free tiers.
# ---------------------------------------------------------------------------

# The GENERATION model (S1 informalization + S2/S3) is NOT an API — it is a
# self-hosted Qwen3-8B-Instruct served with vLLM on Modal L4 / Kaggle T4.
# One fixed, frozen model => each arm is a well-defined condition, no rate
# limit, fully reproducible. Nothing to put here.

# Google Gemini 2.5 Flash (FREE tier) — one of the independent solvers in the
# round-trip / self-consistency check only (multiple independent solvers is
# intentional there). Also the model that did the original translation.
GEMINI_API_KEY=

# DeepSeek (FREE tier) — a second independent solver for the round-trip check
# only. Not used for generation.
DEEPSEEK_API_KEY=

# HuggingFace — model/dataset upload & download on Kaggle / Modal.
HF_TOKEN=

# ---------------------------------------------------------------------------
# LEGACY — used only by the old pipeline in src/; not part of the new plan
# ---------------------------------------------------------------------------
NVIDIA_API_KEYS=
NVIDIA_API_KEY=
BEEKNOEE_API_KEY=
