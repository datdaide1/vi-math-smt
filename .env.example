# Copy this file to .env (or export these as real environment variables) and
# fill in your own keys. Never commit the real .env file.

# ---------------------------------------------------------------------------
# ACTIVE — the new research pipeline (see RESEARCH_PLAN.md / EXECUTION.md)
# NO PAID SERVICES. All keys below are free tiers.
# ---------------------------------------------------------------------------

# NVIDIA NIM (https://integrate.api.nvidia.com/v1) -- the ONLY required key.
# One key serves every hosted model in the plan (§6.0):
#   - GENERATION (S1 informalize + S2/S3) = deepseek-ai/deepseek-v4-pro-0813, seed=42
#   - S2-alt weaker generator / round-trip solver / difficulty ref = meta/llama-3.1-8b-instruct
# The @hus.edu.vn account is rate-limit-only: 40 RPM, NO credit cap. No self-hosted GPU anywhere.
NVIDIA_API_KEY=

# (optional) DeepSeek direct API (api.deepseek.com, 5M-token signup grant) --
# fallback generator only, if NIM is ever unavailable.
DEEPSEEK_API_KEY=

# (optional) Groq (FREE tier, api.groq.com) -- Llama-3.3-70B as an optional
# 3rd independent solver for the round-trip check (SymPy + 2 NIM solvers is enough).
GROQ_API_KEY=

# HuggingFace — model/dataset download locally + upload/download on Modal L4
# (the 1.7B fine-tunes only; 0.6B trains on the local 4 GB laptop GPU).
HF_TOKEN=

# ---------------------------------------------------------------------------
# LEGACY — old src/ pipeline only (translation proxy); not used by the new plan
# ---------------------------------------------------------------------------
BEEKNOEE_API_KEY=
