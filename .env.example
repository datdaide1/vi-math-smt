# Copy this file to .env (or export these as real environment variables) and
# fill in your own keys. Never commit the real .env file.

# ---------------------------------------------------------------------------
# ACTIVE — the new research pipeline (see RESEARCH_PLAN.md / EXECUTION.md)
# NO PAID SERVICES. All keys below are free tiers.
# ---------------------------------------------------------------------------

# GENERATION model (S1 informalization + S2/S3) = Gemini 3.1 Flash Lite, FREE
# tier. 500 RPD per key, so provide 4-5 keys (comma-separated) for round-robin
# rotation -> ~1.5-2k requests/day. One model = each arm is a well-defined
# condition. The client pins model_version + decode config for reproducibility.
GEMINI_API_KEYS=

# Single-key fallback / also used as one of the round-trip solvers.
GEMINI_API_KEY=

# DeepSeek (FREE tier) — a second independent solver for the round-trip
# self-consistency check only. NOT used for generation.
DEEPSEEK_API_KEY=

# HuggingFace — model/dataset upload & download on Kaggle / Modal.
HF_TOKEN=

# ---------------------------------------------------------------------------
# LEGACY — used only by the old pipeline in src/; not part of the new plan
# ---------------------------------------------------------------------------
NVIDIA_API_KEYS=
NVIDIA_API_KEY=
BEEKNOEE_API_KEY=
