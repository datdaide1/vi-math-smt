# Copy this file to .env (or export these as real environment variables) and
# fill in your own keys. Never commit the real .env file.

# ---------------------------------------------------------------------------
# ACTIVE — the new research pipeline (see RESEARCH_PLAN.md / EXECUTION.md)
# NO PAID SERVICES. All keys below are free tiers.
# ---------------------------------------------------------------------------

# GENERATION model (S1 informalization + S2/S3) = deepseek-ai/deepseek-v4-pro-0813
# via NVIDIA NIM (https://integrate.api.nvidia.com/v1), FREE tier, 40 RPM,
# supports seed=42. One fixed model = each arm is a well-defined condition.
# Free tier has a ~1000-credit/month cap PER KEY, so provide several keys
# (comma-separated) for round-robin rotation. The old pipeline already used
# this plural form.
NVIDIA_API_KEYS=
NVIDIA_API_KEY=

# Google Gemini 3.1 Flash Lite (FREE tier, 4-5 keys) — fallback generator if
# NIM credits run out, AND one of the independent round-trip solvers.
GEMINI_API_KEYS=
GEMINI_API_KEY=

# DeepSeek direct API (FREE tier) — another independent round-trip solver.
DEEPSEEK_API_KEY=

# HuggingFace — model/dataset upload & download on Kaggle / Modal.
HF_TOKEN=

# ---------------------------------------------------------------------------
# LEGACY — used only by the old pipeline in src/; not part of the new plan
# ---------------------------------------------------------------------------
NVIDIA_API_KEYS=
NVIDIA_API_KEY=
BEEKNOEE_API_KEY=
